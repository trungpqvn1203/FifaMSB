# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Database — must use asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/webfifa

# Security — CHANGE this in any non-development environment
SECRET_KEY=change-me-in-production

# Environment: development | production
ENVIRONMENT=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Allowed CORS origins (comma-separated for multiple)
# ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
